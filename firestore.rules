rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      function canManageMedicamentos() {
        return signedIn()
          && (request.auth.uid == userId
            || exists(
              /databases/$(database)/documents/users/$(userId)/cuidadores/$(request.auth.uid)
            ));
      }

      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'nome', 'email', 'telefone', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'telefone', 'createdAt']);
      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasAll(['uid', 'nome', 'email', 'telefone', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'uid', 'nome', 'email', 'telefone', 'createdAt',
          'descricao', 'fotoUrl', 'codigoPareamento'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'email', 'telefone', 'descricao', 'fotoUrl'
        ]);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codigoPareamento'])
        && request.resource.data.codigoPareamento is string
        && request.resource.data.codigoPareamento.size() == 16;
      allow delete: if signedIn()
        && request.auth.uid == userId
        && resource.data.uid == userId;

      match /medicamentos/{medicamentoId} {
        allow read, create, update, delete: if canManageMedicamentos();
      }

      match /zelados/{zeladoId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/pairingCodes/$(request.resource.data.codigoPareamento))
          && get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.codigoPareamento)).data.uid == zeladoId
          && request.resource.data.uid == zeladoId
          && request.resource.data.keys().hasAll(['uid', 'nome', 'fotoUrl', 'codigoPareamento', 'dataConexao'])
          && request.resource.data.keys().hasOnly(['uid', 'nome', 'fotoUrl', 'codigoPareamento', 'dataConexao']);
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /cuidadores/{caregiverId} {
        allow get: if signedIn()
          && (request.auth.uid == userId || request.auth.uid == caregiverId);
        allow list: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == caregiverId
          && exists(/databases/$(database)/documents/pairingCodes/$(request.resource.data.codigoPareamento))
          && get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.codigoPareamento)).data.uid == userId
          && request.resource.data.uid == caregiverId
          && request.resource.data.keys().hasAll(['uid', 'nome', 'fotoUrl', 'codigoPareamento', 'dataConexao'])
          && request.resource.data.keys().hasOnly(['uid', 'nome', 'fotoUrl', 'codigoPareamento', 'dataConexao']);
        allow delete: if signedIn()
          && (request.auth.uid == userId || request.auth.uid == caregiverId);
      }
    }

    match /pairingCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.codigoPareamento == code
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'nome', 'fotoUrl'])
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'fotoUrl']);
      allow update: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.codigoPareamento == code
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'nome', 'fotoUrl'])
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'fotoUrl']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}